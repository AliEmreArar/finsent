# Copy to .env and adjust. Everything has a working local default.

# --- LLM (optional) -----------------------------------------------------------
# Without a key the pipeline and the web app use the offline Turkish lexicon.
ANTHROPIC_API_KEY=
FINSENT_LLM_PROVIDER=auto          # auto | anthropic | xai | lexicon
FINSENT_LLM_MODEL=claude-opus-5
FINSENT_LLM_EFFORT=low             # classification works well at low effort
XAI_API_KEY=                       # Grok (xAI): LLM sentiment + X/web search
XAI_MODEL=grok-4.7
# --- sources --------------------------------------------------------------------
FINSENT_MARKET_SOURCE=auto         # auto (sqlite history + yfinance after it) | sqlite | yfinance
FINSENT_KAP_MODE=live              # sample | live

# --- storage ----------------------------------------------------------------------
# LocalStack by default. For real AWS: unset AWS_ENDPOINT_URL and set credentials.
AWS_ENDPOINT_URL=http://localstack:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=eu-central-1
FINSENT_S3_BUCKET=finsent-lake

# --- lakehouse --------------------------------------------------------------------
FINSENT_SPARK_TARGET=local         # local | databricks (needs FINSENT_DATABRICKS_JOB_ID)

MYSQL_PASSWORD=finsent
MYSQL_ROOT_PASSWORD=rootpw
AIRFLOW_ADMIN_PASSWORD=admin
